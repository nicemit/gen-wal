#!/bin/bash

# Gen-Wal CLI Helper
# Usage: genwal [command]

INSTALL_DIR="$HOME/.gen-wal"

# Fallback if python entrypoint isn't found in default location (dev mode)
CLI_ENTRY="$INSTALL_DIR/src/cli.py"
if [ ! -f "$CLI_ENTRY" ]; then
    if [ -f "./src/cli.py" ]; then
        INSTALL_DIR="$(pwd)"
        CLI_ENTRY="./src/cli.py"
    else
        echo "❌ Could not find src/cli.py in $INSTALL_DIR or current directory."
        exit 1
    fi
fi

PYTHON_CMD="python3"
if [ -f "$INSTALL_DIR/venv/bin/python" ]; then
    PYTHON_CMD="$INSTALL_DIR/venv/bin/python"
fi

cd "$INSTALL_DIR" || exit 1

case "$1" in
    logs)
        echo "📋 Tailing logs (Ctrl+C to exit)..."
        journalctl --user -u gen-wal.service -f
        ;;
    run|now|start)
        # If arguments provided, run interactively via cli.py
        if [ "$#" -gt 1 ]; then
             echo "🚀 Running interactively..."
             cd "$INSTALL_DIR" || exit 1
             PYTHONPATH="$INSTALL_DIR" "$PYTHON_CMD" "$CLI_ENTRY" "$@"
        else
             # No args? Trigger background service natively or via cli if missing
             echo "🚀 Triggering background run..."
             if ! systemctl --user start gen-wal.service 2>/dev/null; then
                 echo "⚠️ Background service not found. Running interactively instead..."
                 cd "$INSTALL_DIR" || exit 1
                 PYTHONPATH="$INSTALL_DIR" "$PYTHON_CMD" "$CLI_ENTRY" run
             else
                 echo "Done. Check logs for progress: genwal logs"
             fi
        fi
        ;;
    status)
        systemctl --user status gen-wal.timer
        ;;
    profile)
        # Handle legacy profile commands gracefully
        shift
        if [ "$1" = "list" ] || [ "$1" = "use" ] || [ "$1" = "edit" ]; then
            echo "⚠️ 'profile' is deprecated. Routing to 'theme'..."
            cd "$INSTALL_DIR" || exit 1
            PYTHONPATH="$INSTALL_DIR" "$PYTHON_CMD" "$CLI_ENTRY" theme "$@"
        else
            echo "Usage: genwal theme {list|use|edit}"
        fi
        ;;
    uninstall)
        echo -e "\033[0;31m⚠️  WARNING: You are about to completely remove Gen-Wal and all its settings.\033[0m"
        read -r -p "Are you sure? [y/N] " response
        if [[ "$response" =~ ^([yY][eE][sS]|[yY])$ ]]; then
            if [ -f "$INSTALL_DIR/uninstall.sh" ]; then
                bash "$INSTALL_DIR/uninstall.sh"
            else
                echo "❌ Could not find uninstall.sh in $INSTALL_DIR"
            fi
        else
            echo "Uninstallation cancelled."
        fi
        ;;
    help|--help|-h)
        cd "$INSTALL_DIR" || exit 1
        PYTHONPATH="$INSTALL_DIR" "$PYTHON_CMD" "$CLI_ENTRY" --help
        echo ""
        echo "Service Commands:"
        echo "  logs          - View service logs"
        echo "  status        - Check background timer status"
        echo "  uninstall     - Completely remove Gen-Wal"
        ;;
    *)
        # Route all other commands (theme, config, schedule, history, etc.) directly to the Python CLI
        cd "$INSTALL_DIR" || exit 1
        PYTHONPATH="$INSTALL_DIR" "$PYTHON_CMD" "$CLI_ENTRY" "$@"
        ;;
esac
